# Copy to .env and fill in ONE provider (or none: the twin then runs offline).
# Keys are read by docker compose and passed to the container only. Never commit .env.
LLM_PROVIDER=auto
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
# OPENAI_BASE_URL=            # optional, e.g. an Azure/OpenAI-compatible gateway
# OLLAMA_BASE_URL=http://ollama:11434
# OLLAMA_MODEL=qwen2.5:7b
PORT=8000
# Optional premium voice (ElevenLabs) and live avatar (Simli). Keys stay on the server.
ELEVENLABS_API_KEY=
# Greek transcription model verified by the team; requires Speech to Text permission.
ELEVENLABS_STT_MODEL=scribe_v3
# ELEVENLABS_VOICE_CEO= / ELEVENLABS_VOICE_SALES= / ELEVENLABS_VOICE_FINANCE=
SIMLI_API_KEY=
SIMLI_DAILY_SECONDS=600

# Seeds an EMPTY database only. Existing data is always preserved on updates.
AUTO_SEED=true
