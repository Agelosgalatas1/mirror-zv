# Copy this file to .env. Docker Compose reads .env from this project root.
# Put real credentials only in .env; never commit or send that plaintext file.

# Choose a cloud provider (or leave keys empty for the offline demo).
LLM_PROVIDER=auto
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
USE_EMBEDDINGS=true
OPENAI_BASE_URL=              # optional OpenAI-compatible endpoint
LLM_TIMEOUT=120
MAX_PARALLEL_LLM=4

# Optional local Ollama provider. With Docker Compose use http://ollama:11434.
OLLAMA_BASE_URL=
OLLAMA_MODEL=qwen2.5:7b

# Host port for the web app and API.
PORT=8000

# Optional voice, speech-to-text, and character-specific voice settings.
ELEVENLABS_API_KEY=
ELEVENLABS_MODEL=
# Greek transcription model verified by the team; requires Speech to Text permission.
ELEVENLABS_STT_MODEL=scribe_v3
ELEVENLABS_VOICE_CEO=
ELEVENLABS_VOICE_SALES=
ELEVENLABS_VOICE_FINANCE=
ELEVENLABS_MODEL_CEO=
ELEVENLABS_MODEL_SALES=
ELEVENLABS_MODEL_FINANCE=

# Optional live human avatar. Current subscription permits one active session.
SIMLI_API_KEY=
SIMLI_ENABLED=auto
SIMLI_DAILY_SECONDS=600

# Load synthetic demo data on first start and re-seed if its files change.
AUTO_SEED=true
